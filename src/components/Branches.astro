---
import data from '../data/branches.json';

const branches = (data && data.branches) ? data.branches : [];
---
<div class="branches-list">
  {branches.map((b) => (
    <div class="branch-item" data-reveal>
      <div class="branch-item__head">
        <p class="ed-eyebrow"><span class="ed-eyebrow__line"></span>{b.label}</p>
        <h3 class="branch-item__name">{b.name}</h3>
      </div>
      {b.description && <p class="branch-item__desc">{b.description}</p>}
    </div>
  ))}
</div>

<style>
  .branches-list{max-width:900px;margin:0 auto}
  .branch-item{display:grid;grid-template-columns:1fr 1.3fr;gap:44px;padding:34px 4px;border-top:1px solid var(--line);align-items:start}
  .branch-item:first-child{border-top:0;padding-top:8px}
  .branch-item__name{font-size:1.5rem;font-weight:800;color:var(--blue-dark);margin:13px 0 0;line-height:1.15;letter-spacing:-.01em}
  .branch-item__desc{color:var(--muted);font-size:1.03rem;line-height:1.72;margin:0}
  @media(max-width:640px){
    .branch-item{grid-template-columns:1fr;gap:10px;padding:26px 0}
    .branch-item__desc{margin-top:2px}
  }
</style>
