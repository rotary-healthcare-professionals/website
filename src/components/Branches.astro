---
import data from '../data/branches.json';

const branches = (data && data.branches) ? data.branches : [];
---
<div class="branches-ed">
  {branches.map((b) => (
    <div class="branch-row" data-reveal>
      <p class="branch-row__label">{b.label}</p>
      <h3 class="branch-row__name">{b.name}</h3>
      {b.description && <p class="branch-row__desc">{b.description}</p>}
    </div>
  ))}
</div>

<style>
  .branches-ed{max-width:560px;margin:0 auto}
  .branch-row{text-align:center;padding:26px 16px;border-top:1px solid var(--line)}
  .branch-row:first-child{border-top:0;padding-top:2px}
  .branch-row__label{font-size:.62rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin:0 0 7px}
  .branch-row__name{font-family:'Newsreader',Georgia,serif;font-weight:500;font-size:1.5rem;line-height:1.2;color:var(--blue-dark);margin:0}
  .branch-row__desc{color:var(--muted);font-size:.96rem;line-height:1.6;max-width:44ch;margin:8px auto 0}
  @media(max-width:560px){
    .branch-row{padding:24px 8px}
    .branch-row__name{font-size:1.4rem}
  }
</style>
