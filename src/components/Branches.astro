---
import data from '../data/branches.json';

const branches = (data && data.branches) ? data.branches : [];
---
<div class="branches-list">
  {branches.map((b, i) => (
    <div class="branch-item" data-reveal style={`--d:${i * 0.07}s`}>
      <div class="branch-item__head">
        <p class="ed-eyebrow"><span class="ed-eyebrow__line"></span>{b.label}</p>
        <h3 class="branch-item__name">{b.name}</h3>
      </div>
      {b.description && <p class="branch-item__desc">{b.description}</p>}
    </div>
  ))}
</div>

<style>
  /* Lijevo poravnato (bez margin:auto) -> lijevi rub se poklapa s naslovom sekcije */
  .branches-list{max-width:900px;margin-top:8px}
  .branch-item{display:grid;grid-template-columns:minmax(170px,230px) 1fr;gap:46px;align-items:center;padding:30px 0;border-top:1px solid var(--line)}
  .branch-item:first-child{border-top:0;padding-top:18px}
  .branch-item__name{font-size:1.5rem;font-weight:800;color:var(--blue-dark);margin:11px 0 0;line-height:1.12;letter-spacing:-.015em}
  .branch-item__desc{color:var(--muted);font-size:1.05rem;line-height:1.7;margin:0;max-width:48ch}
  @media(max-width:640px){
    .branch-item{grid-template-columns:1fr;gap:8px;align-items:start;padding:24px 0}
    .branch-item:first-child{padding-top:6px}
    .branch-item__name{font-size:1.32rem}
    .branch-item__desc{margin-top:7px}
  }
</style>
