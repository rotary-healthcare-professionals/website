---
import data from '../data/branches.json';

const branches = (data && data.branches) ? data.branches : [];
---
<div class="branches-list">
  {branches.map((b) => (
    <div class="branch-item" data-reveal>
      <div class="branch-item__head">
        <p class="ed-eyebrow"><span class="ed-eyebrow__line"></span>{b.label}</p>
        <h3 class="branch-item__name">{b.name}</h3>
      </div>
      {b.description && <p class="branch-item__desc">{b.description}</p>}
    </div>
  ))}
</div>

<style>
  .branches-list{max-width:780px;margin:0 auto}
  .branch-item{display:grid;grid-template-columns:210px 1fr;gap:36px;padding:30px 4px;border-top:1px solid var(--line);align-items:center}
  .branch-item:first-child{border-top:0;padding-top:6px}
  .branch-item__name{font-size:1.45rem;font-weight:800;color:var(--blue-dark);margin:12px 0 0;line-height:1.15;letter-spacing:-.01em}
  .branch-item__desc{color:var(--muted);font-size:1.02rem;line-height:1.7;margin:0}
  @media(max-width:640px){
    .branch-item{grid-template-columns:1fr;gap:6px;padding:24px 2px;align-items:start}
    .branch-item__name{font-size:1.35rem}
    .branch-item__desc{margin-top:6px}
  }
</style>
